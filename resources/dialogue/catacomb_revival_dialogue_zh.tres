[resource]
script = ExtResource("1_dialogue")
sequence_id = &"catacomb_revival"
locale_code = &"zh_CN"
speakers = PackedStringArray("守烛人", "夜巡守卫", "守烛人", "夜巡守卫", "守烛人", "守烛人", "夜巡守卫", "守烛人", "夜巡守卫", "夜巡守卫", "夜巡守卫", "守烛人", "守烛人", "夜巡守卫", "守烛人", "守烛人", "守烛人", "夜巡守卫", "守烛人", "守烛人", "夜巡守卫", "守烛人", "守烛人", "守烛人", "守烛人", "守烛人", "守烛人")
lines = PackedStringArray("七年。", "你是谁？", "一个替死者守门的人。", "我为什么还活着？", "你没有活过来。", "只是你的灵魂，再一次被拉回了身体。", "魂契印……", "它拒绝让你离开。", "我只记得一扇门。", "一口钟。", "还有……血。", "有些记忆是在保护你。", "有些记忆，只是在等待我们再次犯下同样的错误。", "我该去哪里？", "去鸦泣城堡。", "找到无声之钟。", "在第十四次钟声响起之前，让它永远沉默。", "为什么是我？", "因为钟认得你。", "也因为你是唯一一个从城堡里回来的人。", "我……回来了？", "穿过暗黑森林。", "沿着旧王道前进。", "守门骑士仍在木桥上等待。", "击败他，大门才会为你开启。", "拿起你的匕首，夜誓者。", "在你寻找真相之前，先学会再次活下去。")
cues = Array[StringName]([&"warden_talk", &"player_talk", &"warden_talk", &"player_talk", &"warden_talk", &"warden_raise_lantern", &"player_look_hands", &"warden_talk", &"player_memory", &"player_memory", &"player_memory", &"warden_talk", &"warden_talk", &"player_talk", &"warden_talk", &"warden_talk", &"warden_raise_lantern", &"player_talk", &"warden_talk", &"warden_talk", &"player_talk", &"warden_turn_away", &"warden_talk", &"warden_talk", &"warden_talk", &"warden_raise_lantern", &"warden_talk"])
durations = PackedFloat32Array(1.9, 1.6, 2.1, 1.7, 1.8, 2.6, 1.7, 1.9, 1.9, 1.5, 1.7, 2.2, 2.7, 1.6, 1.7, 1.7, 2.6, 1.6, 1.8, 2.4, 1.7, 1.7, 1.8, 2.2, 2.1, 2.1, 2.7)
